# PostgreSQL connection (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/allaroundchitown_crm?sslmode=require"

# Google Cloud Places API (New) — server-side only
GOOGLE_PLACES_API_KEY=""

# Optional AI qualification and outreach drafting
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Shared secret used by scheduled lead discovery
CRON_SECRET="replace-with-a-long-random-secret"

# Protects POST /api/inquiries from untrusted callers
INQUIRY_API_SECRET="replace-with-a-long-random-secret"

# Simple admin protection; use a long password in production
CRM_BASIC_AUTH_USER="admin"
CRM_BASIC_AUTH_PASSWORD="replace-with-a-long-random-password"
